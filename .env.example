# cp .env.example .env
#
# Precedence: a command-line flag > .env > your shell environment > defaults.
# Every value is optional. With no .env, minos runs fully local against Ollama.

# local | auto | claude
MINOS_PLANNER=auto

# Ollama 11434, LM Studio 1234, llama.cpp 8080, vLLM 8000
MINOS_BASE_URL=http://localhost:11434/v1

# `minos doctor` reads your VRAM and lists what fits.
# ~8 GB: qwen3:8b (default), llama3.1:8b  |  12-16 GB: qwen3:14b  |  24 GB+: qwen3:32b
MINOS_MODEL=qwen3:8b

# 1 = fail rather than ever calling a remote model
MINOS_OFFLINE=0

MINOS_REMOTE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Audit log, checkpoints, memory, sandboxes and session traces.
MINOS_STATE=.minos
MINOS_MAX_STEPS=20
MINOS_SANDBOX_TIMEOUT=60

# How far back `minos undo` can reach. Age binds first.
MINOS_CHECKPOINT_DAYS=7
MINOS_CHECKPOINT_GB=2

# The tool schemas and system prompt are ~2600 tokens before the task starts, so
# Ollama's 4096 default leaves almost nothing to work in. Ollama's OpenAI
# endpoint IGNORES per-request context, so set it on the server too:
#     OLLAMA_CONTEXT_LENGTH=6144 ollama serve
# Bigger costs VRAM for the KV cache. On an 8 GB card 6144 keeps qwen3:8b at
# 100% GPU; 8192 spills ~16% to CPU and 16384 spills more.
# `minos doctor` reads what is actually served and warns if they disagree.
MINOS_CONTEXT_TOKENS=6144

# Seconds for one model call. A reasoning model on a laptop GPU can spend
# minutes on its <think> block before the first tool call.
MINOS_PLANNER_TIMEOUT=600

# 0 turns off the model's reasoning block (qwen3 and similar). Tool calling
# rarely needs it, and on an 8 GB card it is most of the wall clock.
MINOS_THINKING=1
