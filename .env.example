# cp .env.example .env
#
# Precedence: a command-line flag > .env > your shell environment > defaults.
# Every value is optional. With no .env, minos runs fully local against Ollama.

# auto | local | claude, or any provider in `minos providers`:
#   hosted: openrouter openai groq together deepseek mistral fireworks gemini xai cerebras
#   local : ollama lmstudio llamacpp vllm
#   custom: MINOS_BASE_URL + MINOS_API_KEY, any OpenAI-compatible server
# A hosted model is a remote model: --offline refuses it, and code it writes
# runs in a container (see SECURITY.md).
MINOS_PLANNER=auto

# Ollama 11434, LM Studio 1234, llama.cpp 8080, vLLM 8000
MINOS_BASE_URL=http://localhost:11434/v1

# `minos doctor` reads your VRAM and lists what fits.
# ~8 GB: qwen3:8b (default), llama3.1:8b  |  12-16 GB: qwen3:14b  |  24 GB+: qwen3:32b
MINOS_MODEL=qwen3:8b

# 1 = fail rather than ever calling a remote model
MINOS_OFFLINE=0

MINOS_REMOTE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# For a hosted provider. Blank uses the preset's default; catalogues change,
# so check the provider's model list. OpenRouter ids look like openai/gpt-4.1.
MINOS_HOSTED_MODEL=
# One key per provider, read only by that provider. Never printed.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# FIREWORKS_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# CEREBRAS_API_KEY=
# Fallback for any provider, and the key for MINOS_PLANNER=custom.
# MINOS_API_KEY=

# Audit log, checkpoints, memory, sandboxes and session traces.
MINOS_STATE=.minos
MINOS_MAX_STEPS=20
MINOS_SANDBOX_TIMEOUT=60

# How far back `minos undo` can reach. Age binds first.
MINOS_CHECKPOINT_DAYS=7
MINOS_CHECKPOINT_GB=2

# The tool schemas and system prompt are ~2600 tokens before the task starts, so
# Ollama's 4096 default leaves almost nothing to work in. Ollama's OpenAI
# endpoint IGNORES per-request context, so set it on the server too:
#     OLLAMA_CONTEXT_LENGTH=6144 ollama serve
# Bigger costs VRAM for the KV cache. On an 8 GB card 6144 keeps qwen3:8b at
# 100% GPU; 8192 spills ~16% to CPU and 16384 spills more.
# `minos doctor` reads what is actually served and warns if they disagree.
MINOS_CONTEXT_TOKENS=6144

# Seconds for one model call. A reasoning model on a laptop GPU can spend
# minutes on its <think> block before the first tool call.
MINOS_PLANNER_TIMEOUT=600

# 0 turns off the model's reasoning block (qwen3 and similar). Tool calling
# rarely needs it, and on an 8 GB card it is most of the wall clock.
MINOS_THINKING=1

# The planner -- the part that talks to the model and parses what it says --
# runs in its own process, which cannot write files or start programs (a
# low-integrity token and a one-process job on Windows, Landlock on Linux, a
# seatbelt profile on macOS). Only the broker's process can act. 0 runs it
# in-process, as before; --in-process-planner does the same for one run.
MINOS_ISOLATE_PLANNER=1

# Models that take over, in order, if the one in use becomes unavailable mid-task
# (out of quota, overloaded). PROVIDER:MODEL, comma-separated, e.g.
#   MINOS_FALLBACK=gemini:gemini-3.5-flash,openrouter:google/gemma-4-31b-it:free
# A model that refuses is not overruled: refusals are never handed on.
MINOS_FALLBACK=

# What runs code the model writes, and how much it is trusted.
#
# MINOS_SANDBOX_BACKEND=auto lets the origin below decide: code written by the
# local planner for your own task runs in a confined subprocess (Landlock and
# seccomp on Linux, a low-integrity token and a Job Object on Windows, a
# seatbelt profile on macOS), and code from anywhere else runs in a container
# that shares no namespace with you. Force it with "subprocess" or "container".
MINOS_SANDBOX_BACKEND=auto

# Who wrote the code: local-planner, remote-planner, shared-skill, downloaded.
# Only local-planner is treated as trusted, and only because its input is your
# own task rather than an attacker's. See SECURITY.md.
MINOS_SANDBOX_ORIGIN=local-planner

# The image the container backend runs. It needs a python on PATH and whatever
# the scripts import; the default carries the standard library and nothing else.
MINOS_SANDBOX_IMAGE=python:3.12-slim

# Allow untrusted code to fall back to the subprocess jail when no container
# engine is installed. Off by default: quietly weakening the containment of
# code you do not trust is the thing this setting exists to make explicit.
MINOS_SANDBOX_ALLOW_DOWNGRADE=0
