# minos configuration
#
#   cp .env.example .env
#
# Copy this file to .env and edit it. .env is gitignored; this one is committed,
# so never put a real key in here.
#
# Precedence, narrowest first:
#
#   a command-line flag  >  .env  >  your shell environment  >  these defaults
#
# A flag you typed always wins. Nothing below can override it.
#
# Every value here is optional. With no .env at all, minos runs fully local
# against Ollama on this machine -- which is the point of the project, not a
# fallback.


# ---------------------------------------------------------------------------
# The local model. This is the default path and the one that gets the attention.
# ---------------------------------------------------------------------------

# Which planner writes the plan.
#   local   always the local server below; never calls out
#   auto    local when the server is listening, otherwise the remote model
#   claude  always the remote API (needs ANTHROPIC_API_KEY)
MINOS_PLANNER=auto

# Any OpenAI-compatible endpoint. Ollama is the default and needs no config.
#   Ollama       http://localhost:11434/v1
#   LM Studio    http://localhost:1234/v1
#   llama.cpp    http://localhost:8080/v1
#   vLLM         http://localhost:8000/v1
MINOS_BASE_URL=http://localhost:11434/v1

# The local model to plan with.
#
# This runtime asks a model to pick one of about a dozen typed tools and fill in
# its arguments -- not to write prose -- so a small model does better here than
# its benchmark scores suggest. Fit matters more than size: a model that fits in
# VRAM is roughly 100x faster than one that spills to system RAM.
#
#   ~8 GB VRAM    qwen3:8b            the tested default, 12/15 on the suite
#                 llama3.1:8b         solid tool calling
#                 mistral-nemo:12b    at Q4, tight but it fits
#   ~12-16 GB     qwen3:14b           noticeably better at multi-step plans
#                 qwen2.5-coder:14b   strongest for the code tier
#   ~24 GB+       qwen3:32b           best local quality tested
#
#   uv run minos doctor     reads your actual VRAM and says what fits
#   ollama pull qwen3:8b    then this line is all you need
MINOS_MODEL=qwen3:8b

# Refuse to call a remote model at all. With this set, a missing local server is
# an error rather than a quiet fallback to the cloud -- which makes "offline" a
# guarantee instead of a preference.
MINOS_OFFLINE=0


# ---------------------------------------------------------------------------
# The remote model. Only used when MINOS_PLANNER is claude, or auto with no
# local server running.
# ---------------------------------------------------------------------------

MINOS_REMOTE_MODEL=claude-opus-5

# Your key. Never commit this -- set it in .env, which is gitignored.
# ANTHROPIC_API_KEY=sk-ant-...


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Where the audit log, checkpoints, memory index and sandboxes live. Deleting
# this directory resets everything the runtime knows.
MINOS_STATE=.minos

# Give up on a task after this many actions. A runaway agent is stopped by a
# budget, not by good intentions.
MINOS_MAX_STEPS=20

# Kill a sandboxed script after this many seconds.
MINOS_SANDBOX_TIMEOUT=60


# ---------------------------------------------------------------------------
# Checkpoint retention
#
# Checkpoints are what `minos undo` restores from, so these two decide how far
# back you can undo. Age binds first; if the store is still over budget, the
# oldest survivors go until it fits.
# ---------------------------------------------------------------------------

MINOS_CHECKPOINT_DAYS=7
MINOS_CHECKPOINT_GB=2
