# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# uv
uv.lock.bak

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# minos runtime state — never commit audit logs, checkpoints or sandboxes.
# Anchored to the state directory: a bare `sandbox/` also matched
# src/minos/sandbox/, so every new file in the sandbox package was silently
# untracked and `git status` said nothing.
*.jsonl
.minos/
**/.minos/
checkpoints/
.minos/sandbox/

# Local configuration. .env.example is the committed one.
.env
.env.local
!.env.example
.DS_Store
Thumbs.db

# Eval run logs. The JSON results are committed; the console output is not.
eval/*.log

# Internal research notes: kept locally, not published.
docs/research/
